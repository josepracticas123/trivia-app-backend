generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

//Tabla de categorías,
model Category {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  questions Question[]
}
// Tabla de preguntas.
model Question {
  id         Int      @id @default(autoincrement())
  statement  String
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  choices    Option[]
}
// Tabla para opciones
model Option {
  id         Int      @id @default(autoincrement())
  text       String
  position   Int
  isCorrect  Boolean
  questionId Int
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, position])
  @@unique([questionId, text])
}

// Roles disponibles para los usuarios.
enum Role {
  USER
  ADMIN
}

// Modelo de tabla para usuario.
model user{
  id Int @id @default(autoincrement())
  email String @unique
  passwordHash String
  createdAt DateTime @default(now())
  role Role @default(USER)
}
