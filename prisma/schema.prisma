generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

//Tabla de categorías,
model Category {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  questions Question[]
}

// Tabla de preguntas.
model Question {
  id            Int            @id @default(autoincrement())
  statement     String
  categoryId    Int
  category      Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  choices       Option[]
  gameQuestions GameQuestion[]
}

// Tabla para opciones
model Option {
  id         Int      @id @default(autoincrement())
  text       String
  position   Int
  isCorrect  Boolean
  questionId Int
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, position])
  @@unique([questionId, text])
}

// Roles disponibles para los usuarios.
enum Role {
  USER
  ADMIN
}

// Modelo de tabla para usuario.
model user {
  id           Int          @id @default(autoincrement())
  email        String       @unique
  passwordHash String
  createdAt    DateTime     @default(now())
  role         Role         @default(USER)
  games        GamePlayer[]
}

enum GameMode {
  INDIVIDUAL
  MULTIPLAYER
}

// Ciclo de vida de una partida: la sala multijugador espera al segundo
// jugador (WAITING), después se juega (ACTIVE) y finalmente se cierra.
enum GameStatus {
  WAITING
  ACTIVE
  FINISHED
}

// Una partida de trivia.
model Game {
  id         Int            @id @default(autoincrement())
  mode       GameMode       @default(INDIVIDUAL)
  code       String?        @unique
  status     GameStatus     @default(ACTIVE)
  createdAt  DateTime       @default(now())
  finishedAt DateTime?
  players    GamePlayer[]
  questions  GameQuestion[]
}

// Participantes de una partida, tanto individual como multijugador.
// isCreator identifica al usuario que puede iniciar una sala WAITING.
model GamePlayer {
  id     Int  @id @default(autoincrement())
  game   Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
  gameId Int
  user   user @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int
  isCreator Boolean @default(false)

  // Un usuario no puede estar dos veces en la misma partida.
  @@unique([gameId, userId])
}

// Pregunta congelada dentro de una partida: copia del enunciado,
// las opciones y la solución del catálogo en el momento de crearla.
model GameQuestion {
  id         Int          @id @default(autoincrement())
  game       Game         @relation(fields: [gameId], references: [id], onDelete: Cascade)
  gameId     Int
  position   Int // Orden en la partida (0..4)
  statement  String // Copia del enunciado
  solution   Int // Copia de la respuesta correcta (0..3)
  question   Question?    @relation(fields: [questionId], references: [id], onDelete: SetNull)
  questionId Int? // Origen en el catálogo (por trazabilidad; si se borra, no rompe)
  choices    GameChoice[]
  answers    Answer[]

  // La misma pregunta no se repite dentro de una partida.
  @@unique([gameId, position])
}

// Copia de una opción dentro de una pregunta de partida.
model GameChoice {
  id             Int          @id @default(autoincrement())
  gameQuestion   GameQuestion @relation(fields: [gameQuestionId], references: [id], onDelete: Cascade)
  gameQuestionId Int
  text           String
  position       Int // 0..3
  answers        Answer[]

  @@unique([gameQuestionId, position])
}

// Una respuesta por pregunta de partida. En el reto 16 la sala ya puede
// iniciarse, pero los turnos y una respuesta de CADA jugador se añaden
// en el reto 17; por eso todavía no se guarda userId aquí.
model Answer {
  id             Int          @id @default(autoincrement())
  gameQuestion   GameQuestion @relation(fields: [gameQuestionId], references: [id], onDelete: Cascade)
  gameQuestionId Int
  choice         GameChoice   @relation(fields: [choiceId], references: [id], onDelete: Cascade)
  choiceId       Int
  isCorrect      Boolean
  createdAt      DateTime     @default(now())

  // Responder dos veces la misma pregunta: imposible a nivel de base.
  @@unique([gameQuestionId])
}
