# Copia este archivo a .env. No subas .env a Git.
PORT=3000

# Configura la URL de tu base de datos de prácticas.
DATABASE_URL=

# Genera un secreto con este comando:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# FRONTEND_ORIGIN se añadirá en el reto 15.
FRONTEND_ORIGIN=http://localhost:5173